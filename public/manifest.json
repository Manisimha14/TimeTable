{
  "id": "com.scaler.ssttimetable",
  "name": "SST 2029 Term 5 Timetable",
  "short_name": "SST Timetable",
  "description": "Scaler School of Technology Term 5 Timetable & Academic Calendar Dashboard",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#161826",
  "theme_color": "#161826",
  "categories": ["education", "productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [],
  "iarc_rating_id": "e84b3b08-3e14-49c0-9a3d-4c330fef6b8c",
  "scope_extensions": [
    { "origin": "*.vercel.app" }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "protocol_handlers": [
    {
      "protocol": "web+sst",
      "url": "/?sync=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/?view=personal"
  },
  "widgets": [
    {
      "name": "Daily Timetable Widget",
      "short_name": "Schedule",
      "description": "Scaler SST Daily Schedule",
      "tag": "sst-daily-widget",
      "template": "widget-template",
      "ms_ac_template": "widget.json"
    }
  ],
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Scaler SST 2029 Timetable Dashboard"
    },
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Timetable View"
    }
  ],
  "shortcuts": [
    {
      "name": "Class Schedule",
      "short_name": "Schedule",
      "description": "View today's class timetable",
      "url": "/",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "Courses & Syllabus",
      "short_name": "Courses",
      "description": "Track course syllabus and self-study progress",
      "url": "/?view=courses",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "Personal Deadlines",
      "short_name": "Deadlines",
      "description": "View personal tasks and deadlines",
      "url": "/?view=personal",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    },
    {
      "name": "Student Tools",
      "short_name": "Tools",
      "description": "Bunk calculator, shortcuts and study tools",
      "url": "/?view=tools",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192" }]
    }
  ]
}
