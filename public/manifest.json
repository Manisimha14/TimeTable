{
  "id": "com.scaler.ssttimetable",
  "name": "SST 2029 Term 5 Timetable",
  "short_name": "SST Timetable",
  "description": "Scaler School of Technology Term 5 Timetable & Academic Calendar Dashboard",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "fullscreen"
  ],
  "orientation": "any",
  "background_color": "#1c2da4",
  "theme_color": "#2435ae",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "iarc_rating_id": "e84b3b08-3e14-49c0-9a3d-4c330fef6b8c",

  "icons": [
    { "src": "/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/favicon.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.png", "sizes": "48x48", "type": "image/png", "purpose": "monochrome" }
  ],

  "screenshots": [
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Weekly timetable view on desktop"
    },
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Today's schedule on mobile"
    },
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Upcoming deadlines view"
    }
  ],

  "shortcuts": [
    {
      "name": "Today's Schedule",
      "short_name": "Today",
      "description": "Jump straight to today's classes",
      "url": "/?view=today",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Upcoming Deadlines",
      "short_name": "Deadlines",
      "description": "See assignments and exams due soon",
      "url": "/?view=deadlines",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Full Week View",
      "short_name": "Week",
      "description": "See the full Term 5 weekly grid",
      "url": "/?view=week",
      "icons": [{ "src": "/favicon.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],

  "scope_extensions": [
    { "origin": "*.vercel.app" }
  ],

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "protocol_handlers": [
    { "protocol": "web+sst", "url": "/?sync=%s" }
  ],

  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/pdf": [".pdf"],
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      },
      "icons": [{ "src": "/favicon.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],

  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "edge_side_panel": {
    "preferred_width": 400
  },

  "note_taking": {
    "new_note_url": "/?view=personal"
  },

  "handle_links": "preferred",

  "widgets": [
    {
      "name": "Next Class",
      "short_name": "Next Class",
      "description": "Shows the very next class on your Term 5 timetable, with room and time.",
      "tag": "next-class",
      "template": "next-class-template",
      "ms_ac_template": "/widgets/next-class.json",
      "data": "/widgets/next-class-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon.png",
          "sizes": "512x512",
          "label": "Next Class widget preview"
        }
      ],
      "icons": [
        { "src": "/favicon.png", "sizes": "192x192" }
      ],
      "auth": false,
      "update": 900
    },
    {
      "name": "Today's Schedule",
      "short_name": "Today",
      "description": "A compact view of every class remaining today.",
      "tag": "today-schedule",
      "template": "today-schedule-template",
      "ms_ac_template": "/widgets/today-schedule.json",
      "data": "/widgets/today-schedule-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon.png",
          "sizes": "512x512",
          "label": "Today's Schedule widget preview"
        }
      ],
      "icons": [
        { "src": "/favicon.png", "sizes": "192x192" }
      ],
      "auth": false,
      "update": 3600
    },
    {
      "name": "Upcoming Deadlines",
      "short_name": "Deadlines",
      "description": "Assignments, quizzes, and exams due in the next 7 days.",
      "tag": "upcoming-deadlines",
      "template": "deadlines-template",
      "ms_ac_template": "/widgets/deadlines.json",
      "data": "/widgets/deadlines-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icon.png",
          "sizes": "512x512",
          "label": "Upcoming Deadlines widget preview"
        }
      ],
      "icons": [
        { "src": "/favicon.png", "sizes": "192x192" }
      ],
      "auth": false,
      "update": 3600
    }
  ]
}
